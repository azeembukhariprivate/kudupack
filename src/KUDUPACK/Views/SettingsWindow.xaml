<Window x:Class="Kudupack.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - KUDUPACK" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/KUDUPACK;component/Assets/KUDUPACK.ico"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <StackPanel>
        <StackPanel Margin="24,20,24,8">
            <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <TextBlock Text="Appearance" Style="{StaticResource Heading}" Margin="0,0,0,8"/>
            <WrapPanel>
                <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="Same as Windows" Style="{StaticResource ChipRadio}" Checked="Theme_Checked"/>
                <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="Light" Style="{StaticResource ChipRadio}" Checked="Theme_Checked"/>
                <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="Dark" Style="{StaticResource ChipRadio}" Checked="Theme_Checked"/>
            </WrapPanel>

            <TextBlock Text="After extracting" Style="{StaticResource Heading}" Margin="0,14,0,4"/>
            <CheckBox x:Name="OpenFolder" Content="Open the folder with the extracted files" Click="Option_Click"/>
            <CheckBox x:Name="DeleteArchive" Content="Move the archive to the Recycle Bin" Click="Option_Click"/>
            <TextBlock Text="Only after everything was extracted. Split archives are never removed." Style="{StaticResource Subtle}" Margin="24,0,0,0"/>

            <TextBlock Text="File Explorer" Style="{StaticResource Heading}" Margin="0,16,0,4"/>
            <CheckBox x:Name="ContextMenuBox" Content="Show KUDUPACK in the right-click menu" Click="ContextMenu_Click"/>
            <TextBlock Text="Adds Extract here, Extract to folder and Add to archive. On Windows 11 they're under &quot;Show more options&quot;."
                       Style="{StaticResource Subtle}" Margin="24,0,0,0"/>
            <CheckBox x:Name="Associate" Content="Open archives with KUDUPACK when double-clicked" Click="Associate_Click" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                <TextBlock Text="Windows may ask you to confirm. You can also choose it in" Style="{StaticResource Subtle}" VerticalAlignment="Center"/>
                <Button Content="Default apps" Style="{StaticResource LinkButton}" Margin="4,0,0,0" FontSize="12" Click="DefaultApps_Click"/>
            </StackPanel>

            <TextBlock Text="Updates" Style="{StaticResource Heading}" Margin="0,16,0,4"/>
            <CheckBox x:Name="CheckUpdates" Content="Tell me when a new version is on GitHub" Click="Option_Click"/>

            <Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,10" Margin="0,18,0,8">
                <TextBlock Style="{StaticResource Subtle}" FontSize="12"
                           Text="All settings are saved for your Windows account only, so KUDUPACK never needs administrator rights. If you want to extract into a protected folder such as Program Files, close KUDUPACK and start it with &quot;Run as administrator&quot;."/>
            </Border>
        </StackPanel>
        <Border Background="{DynamicResource SurfaceAltBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <Button Content="Done" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="90"
                    IsDefault="True" IsCancel="True" Click="Done_Click"/>
        </Border>
    </StackPanel>
</Window>
