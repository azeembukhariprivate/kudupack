<Window x:Class="Kudupack.Views.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password - KUDUPACK" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/KUDUPACK;component/Assets/KUDUPACK.ico"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        FocusManager.FocusedElement="{Binding ElementName=PasswordInput}">
    <StackPanel Margin="24,20">
        <TextBlock Text="Enter password" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock x:Name="MessageText" Style="{StaticResource Subtle}" FontSize="13" Margin="0,6,0,16"/>
        <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="PasswordInput"/>
        <CheckBox x:Name="ShowPassword" Content="Show password" Margin="0,10,0,0"
                  Checked="ShowPassword_Changed" Unchecked="ShowPassword_Changed"/>
        <TextBox x:Name="PlainInput" Visibility="Collapsed" Margin="0,8,0,0" IsReadOnly="True"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,10,0"/>
            <Button Content="OK" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" MinWidth="80"/>
        </StackPanel>
    </StackPanel>
</Window>
