<Window x:Class="Kudupack.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Kudupack.Controls"
        xmlns:core="clr-namespace:Kudupack.Core"
        Title="KUDUPACK" Width="1100" Height="720" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Icon="/KUDUPACK;component/Assets/KUDUPACK.ico"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Update banner -->
        <Border x:Name="UpdateBanner" Grid.Row="0" Background="{DynamicResource BannerBg}" Padding="16,8" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" MinHeight="28" Padding="6,0"
                        Click="DismissUpdate_Click" ToolTip="Dismiss" AutomationProperties.Name="Dismiss update notice">
                    <c:Glyph Data="{StaticResource IconClose}" Width="14" Height="14"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Download" Margin="0,0,12,0"
                        VerticalAlignment="Center" Click="DownloadUpdate_Click"/>
                <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- ================= HOME ================= -->
        <Grid x:Name="HomeView" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="920" Margin="24,24,24,32">

                    <!-- Drop zone -->
                    <Grid MinHeight="250">
                        <Rectangle RadiusX="12" RadiusY="12" Fill="{DynamicResource SurfaceBg}"
                                   Stroke="{DynamicResource DropBorder}" StrokeThickness="2" StrokeDashArray="5 3"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,36">
                            <c:LogoMark Width="60" Height="60" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Drop files or an archive here" FontSize="24" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,14,0,6" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock Text="Drop an archive to open it. Drop files or folders to pack them into a new archive."
                                       Foreground="{DynamicResource SubtleText}" FontSize="14" MaxWidth="480"
                                       TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                            <WrapPanel HorizontalAlignment="Center" Margin="0,20,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Margin="6" MinHeight="44" Click="OpenArchive_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <c:Glyph Data="{StaticResource IconFolder}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Open archive…"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Margin="6" MinHeight="44" Click="CreateArchive_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <c:Glyph Data="{StaticResource IconArchive}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Create archive…"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Margin="6" MinHeight="44" Click="BatchExtract_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <c:Glyph Data="{StaticResource IconLayers}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Extract many…"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Formats and recent -->
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Grid.Column="0">
                            <StackPanel>
                                <TextBlock Text="Supported formats" Style="{StaticResource Heading}" Margin="0,0,0,12"/>
                                <TextBlock Text="OPEN &amp; EXTRACT" Style="{StaticResource Caps}"/>
                                <ItemsControl x:Name="ReadFormats">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource ChipBg}" CornerRadius="4" Padding="8,3" Margin="0,0,6,6">
                                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource ChipText}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="CREATE" Style="{StaticResource Caps}" Margin="0,10,0,8"/>
                                <ItemsControl x:Name="WriteFormats">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource NeutralChipBg}" CornerRadius="4" Padding="8,3" Margin="0,0,6,6">
                                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Text}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="RAR archives can be opened and extracted, but not created." Style="{StaticResource Subtle}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Grid.Column="2">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button x:Name="ClearRecentButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}"
                                            Content="Clear" Click="ClearRecent_Click"/>
                                    <TextBlock Text="Recent archives" Style="{StaticResource Heading}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="NoRecentText" Text="Archives you open will show up here."
                                           Style="{StaticResource Subtle}" Margin="0,6,0,0"/>
                                <ItemsControl x:Name="RecentList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"
                                                    Padding="8,6" Tag="{Binding Path}" Click="RecentItem_Click" ToolTip="{Binding Path}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Type}" FontFamily="Consolas" FontSize="11"
                                                               Foreground="{DynamicResource SubtleText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    <c:Glyph Data="{StaticResource IconFile}" Width="20" Height="20" Margin="0,0,10,0"
                                                             TextElement.Foreground="{DynamicResource SubtleText}"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Subtle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,4">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="About_Click">
                        <StackPanel Orientation="Horizontal">
                            <c:Glyph Data="{StaticResource IconInfo}" Margin="0,0,6,0" Width="14" Height="14"/>
                            <TextBlock Text="About"/>
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="Settings_Click">
                        <StackPanel Orientation="Horizontal">
                            <c:Glyph Data="{StaticResource IconSettings}" Margin="0,0,6,0" Width="14" Height="14"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="HomeStatus" Style="{StaticResource Subtle}" VerticalAlignment="Center" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= ARCHIVE ================= -->
        <Grid x:Name="ArchiveView" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBg}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,1" Padding="10,6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Margin="4,0" Click="CreateArchive_Click">
                            <StackPanel Orientation="Horizontal">
                                <c:Glyph Data="{StaticResource IconArchive}" Margin="0,0,8,0"/>
                                <TextBlock Text="New archive"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Click="Settings_Click" ToolTip="Settings" AutomationProperties.Name="Settings">
                            <c:Glyph Data="{StaticResource IconSettings}"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Click="About_Click" ToolTip="About" AutomationProperties.Name="About">
                            <c:Glyph Data="{StaticResource IconInfo}"/>
                        </Button>
                    </StackPanel>
                    <WrapPanel>
                        <Button Style="{StaticResource GhostButton}" Click="CloseArchive_Click" ToolTip="Back to start" AutomationProperties.Name="Back to start" Margin="0,0,4,0">
                            <c:Glyph Data="{StaticResource IconHome}"/>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Margin="2,0" Click="ExtractAll_Click"
                                ToolTip="Extract everything into a new folder next to the archive">
                            <StackPanel Orientation="Horizontal">
                                <c:Glyph Data="{StaticResource IconExtract}" Margin="0,0,8,0"/>
                                <TextBlock Text="Extract all"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Margin="2,0" Click="ExtractTo_Click"
                                ToolTip="Extract the selected items (or everything) to a folder you choose">
                            <StackPanel Orientation="Horizontal">
                                <c:Glyph Data="{StaticResource IconExtractTo}" Margin="0,0,8,0"/>
                                <TextBlock Text="Extract to…"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddButton" Style="{StaticResource GhostButton}" Margin="2,0" Click="AddFiles_Click">
                            <StackPanel Orientation="Horizontal">
                                <c:Glyph Data="{StaticResource IconPlus}" Margin="0,0,8,0"/>
                                <TextBlock Text="Add files"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeleteButton" Style="{StaticResource GhostButton}" Margin="2,0" Click="Delete_Click">
                            <StackPanel Orientation="Horizontal">
                                <c:Glyph Data="{StaticResource IconTrash}" Margin="0,0,8,0"/>
                                <TextBlock Text="Delete"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Margin="2,0" Click="Test_Click" ToolTip="Check the archive for errors">
                            <StackPanel Orientation="Horizontal">
                                <c:Glyph Data="{StaticResource IconCheck}" Margin="0,0,8,0"/>
                                <TextBlock Text="Test"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Margin="2,0" Click="Info_Click">
                            <StackPanel Orientation="Horizontal">
                                <c:Glyph Data="{StaticResource IconInfo}" Margin="0,0,8,0"/>
                                <TextBlock Text="Info"/>
                            </StackPanel>
                        </Button>
                        <ToggleButton x:Name="PreviewToggle" Margin="2,0" Padding="10,0" MinHeight="36" Cursor="Hand"
                                      Checked="PreviewToggle_Changed" Unchecked="PreviewToggle_Changed"
                                      ToolTip="Show a preview of the selected file" Foreground="{DynamicResource Text}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <StackPanel Orientation="Horizontal">
                                <c:Glyph Data="{StaticResource IconEye}" Margin="0,0,8,0"/>
                                <TextBlock Text="Preview"/>
                            </StackPanel>
                        </ToggleButton>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- Path and search -->
            <Grid Grid.Row="1" Margin="10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource GhostButton}" Click="Up_Click" ToolTip="Up one folder"
                        AutomationProperties.Name="Up one folder" Margin="0,0,6,0">
                    <c:Glyph Data="{StaticResource IconUp}"/>
                </Button>
                <Border Grid.Column="1" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource InputBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="10,0" MinHeight="34">
                    <TextBlock x:Name="PathText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Border>
                <Grid Grid.Column="3">
                    <TextBox x:Name="SearchBox" Padding="30,7,8,7" TextChanged="SearchBox_TextChanged"
                             AutomationProperties.Name="Search in archive"/>
                    <c:Glyph Data="{StaticResource IconSearch}" Width="14" Height="14" HorizontalAlignment="Left" Margin="10,0,0,0"
                             TextElement.Foreground="{DynamicResource SubtleText}"/>
                    <TextBlock x:Name="SearchHint" Text="Search in archive" Margin="31,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource SubtleText}" IsHitTestVisible="False"/>
                </Grid>
            </Grid>

            <!-- Tree, list, preview -->
            <Grid Grid.Row="2" Margin="10,0,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="140"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                    <ColumnDefinition x:Name="PreviewSplitColumn" Width="10"/>
                    <ColumnDefinition x:Name="PreviewColumn" Width="300" MinWidth="0"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="4,6">
                    <TreeView x:Name="FolderTree" SelectedItemChanged="FolderTree_SelectedItemChanged"
                              AutomationProperties.Name="Folders">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type core:ArchiveNode}" ItemsSource="{Binding SubFolders}">
                                <StackPanel Orientation="Horizontal">
                                    <c:Glyph Data="{StaticResource IconFolder}" Margin="0,0,6,0" TextElement.Foreground="{DynamicResource FolderBrush}"/>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Border>

                <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent"/>

                <Border Grid.Column="2" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <ListView x:Name="FileList" SelectionMode="Extended" Margin="1"
                                  AutomationProperties.Name="Files in archive"
                                  MouseDoubleClick="FileList_MouseDoubleClick"
                                  SelectionChanged="FileList_SelectionChanged"
                                  PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="FileList_PreviewMouseMove"
                                  KeyDown="FileList_KeyDown"
                                  GridViewColumnHeader.Click="FileList_HeaderClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" Width="340">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                                                    <c:Glyph Data="{StaticResource IconFolder}" Margin="0,0,10,0"
                                                             TextElement.Foreground="{DynamicResource FolderBrush}"
                                                             Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibility}}"/>
                                                    <c:Glyph Data="{StaticResource IconFile}" Margin="0,0,10,0"
                                                             TextElement.Foreground="{DynamicResource SubtleText}"
                                                             Visibility="{Binding IsFile, Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Size" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Modified" Width="160">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource SubtleText}" Margin="6,0,0,0"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Type" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TypeText}" Foreground="{DynamicResource SubtleText}" Margin="6,0,0,0"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock x:Name="EmptyText" Text="This folder is empty." Style="{StaticResource Subtle}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <GridSplitter x:Name="PreviewSplitter" Grid.Column="3" Width="10" HorizontalAlignment="Stretch" Background="Transparent"/>

                <Border x:Name="PreviewPane" Grid.Column="4" Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Preview" Style="{StaticResource Heading}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="PreviewName" DockPanel.Dock="Top" Style="{StaticResource Subtle}" Margin="0,0,0,10"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top"
                                   RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                            <TextBox x:Name="PreviewText" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" Visibility="Collapsed"/>
                            <TextBlock x:Name="PreviewMessage" Style="{StaticResource Subtle}" FontSize="13"
                                       Text="Select a file to preview it."/>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,7">
                <DockPanel>
                    <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Style="{StaticResource Subtle}" TextWrapping="NoWrap"/>
                    <TextBlock x:Name="StatusLeft" Style="{StaticResource Subtle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Busy overlay (opening an archive) -->
        <Grid x:Name="BusyOverlay" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource OverlayBg}" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                <StackPanel>
                    <TextBlock x:Name="BusyText" Text="Opening…" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
                    <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Minimum="0" Maximum="100"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
