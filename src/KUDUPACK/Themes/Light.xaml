<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="TextColor">#1B1B1B</Color>
    <Color x:Key="SelectionColor">#E5EFFA</Color>

    <SolidColorBrush x:Key="WindowBg" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="SurfaceBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBg" Color="#FBFBFB"/>
    <SolidColorBrush x:Key="Text" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="SubtleText" Color="#5C5C5C"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="InputBorder" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Accent" Color="#0F6CBD"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LinkText" Color="#0F6CBD"/>
    <SolidColorBrush x:Key="SelectionBg" Color="#E5EFFA"/>
    <SolidColorBrush x:Key="HoverBg" Color="#EFEFEF"/>
    <SolidColorBrush x:Key="ChipBg" Color="#EEF4FB"/>
    <SolidColorBrush x:Key="ChipText" Color="#0A4F8C"/>
    <SolidColorBrush x:Key="NeutralChipBg" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="DropBorder" Color="#A8A8A8"/>
    <SolidColorBrush x:Key="FolderBrush" Color="#B07A12"/>
    <SolidColorBrush x:Key="BannerBg" Color="#E5EFFA"/>
    <SolidColorBrush x:Key="OverlayBg" Color="#B3F3F3F3"/>

    <!-- Selection colours used by the folder tree -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E5EFFA"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E5EFFA"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1B1B1B"/>
</ResourceDictionary>
