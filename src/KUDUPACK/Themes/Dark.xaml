<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="TextColor">#F2F2F2</Color>
    <Color x:Key="SelectionColor">#1F3A55</Color>

    <SolidColorBrush x:Key="WindowBg" Color="#202020"/>
    <SolidColorBrush x:Key="SurfaceBg" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="SurfaceAltBg" Color="#272727"/>
    <SolidColorBrush x:Key="Text" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="SubtleText" Color="#B4B4B4"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="InputBorder" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="InputBg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Accent" Color="#0F6CBD"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LinkText" Color="#6CB8F6"/>
    <SolidColorBrush x:Key="SelectionBg" Color="#1F3A55"/>
    <SolidColorBrush x:Key="HoverBg" Color="#353535"/>
    <SolidColorBrush x:Key="ChipBg" Color="#1F3A55"/>
    <SolidColorBrush x:Key="ChipText" Color="#CDE4FA"/>
    <SolidColorBrush x:Key="NeutralChipBg" Color="#353535"/>
    <SolidColorBrush x:Key="DropBorder" Color="#6A6A6A"/>
    <SolidColorBrush x:Key="FolderBrush" Color="#E3A93B"/>
    <SolidColorBrush x:Key="BannerBg" Color="#1F3A55"/>
    <SolidColorBrush x:Key="OverlayBg" Color="#B3202020"/>

    <!-- Selection colours used by the folder tree -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1F3A55"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1F3A55"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F2F2F2"/>
</ResourceDictionary>
