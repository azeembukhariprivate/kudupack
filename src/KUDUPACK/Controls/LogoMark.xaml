<UserControl x:Class="Kudupack.Controls.LogoMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" IsTabStop="False" Focusable="False">
    <!-- Three stacked suitcases: the KUDUPACK mark. -->
    <Viewbox>
        <Canvas Width="64" Height="64">
            <Rectangle Canvas.Left="8" Canvas.Top="42" Width="48" Height="14" RadiusX="3" RadiusY="3"
                       Stroke="{Binding Foreground, ElementName=Root}" StrokeThickness="3.5"/>
            <Rectangle Canvas.Left="13" Canvas.Top="28" Width="38" Height="12" RadiusX="3" RadiusY="3"
                       Stroke="{Binding Foreground, ElementName=Root}" StrokeThickness="3.5"/>
            <Rectangle Canvas.Left="19" Canvas.Top="16" Width="26" Height="10" RadiusX="3" RadiusY="3"
                       Stroke="{Binding Foreground, ElementName=Root}" StrokeThickness="3.5"/>
            <Path Data="M27,16 V11 H37 V16 M20,43 V55 M44,43 V55 M23,29 V39 M41,29 V39"
                  Stroke="{Binding Foreground, ElementName=Root}" StrokeThickness="3.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Canvas>
    </Viewbox>
</UserControl>
