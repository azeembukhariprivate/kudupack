<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KUDUPACK</AssemblyName>
    <RootNamespace>Kudupack</RootNamespace>
    <ApplicationIcon>Assets\KUDUPACK.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Version>1.0.2</Version>
    <Product>KUDUPACK</Product>
    <Company>Azeem</Company>
    <Authors>Azeem</Authors>
    <Copyright>Copyright © 2026 Azeem</Copyright>
    <Description>KUDUPACK archive tool</Description>

    <!-- The 7z.dll files are copied explicitly below. -->
    <NG7zLibsCopyToOutput>false</NG7zLibsCopyToOutput>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Squid-Box.SevenZipSharp" Version="1.6.2.24" />
    <PackageReference Include="7z.Libs" Version="26.4.0" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\KUDUPACK.ico" />
    <None Include="$(Pkg7z_Libs)\bin\x64\7z.dll" Link="x64\7z.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(Pkg7z_Libs)\bin\x86\7z.dll" Link="x86\7z.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\licenses\*.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="Check7zLibs" BeforeTargets="Build">
    <Error Condition="!Exists('$(Pkg7z_Libs)\bin\x64\7z.dll')" Text="7z.dll was not found in the 7z.Libs package (looked in '$(Pkg7z_Libs)\bin\x64')." />
  </Target>

</Project>
